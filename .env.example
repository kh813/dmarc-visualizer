# ==============================================================================
# DMARC Visualizer Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Access Control & Port Settings
# ------------------------------------------------------------------------------

# IP Address to bind Grafana Web UI
# - "0.0.0.0" (Default)  : Accessible from local host AND other devices on your LAN (e.g. http://<LAN-IP>:3000).
# - "127.0.0.1"          : Accessible ONLY from this local machine (loopback). Blocks all LAN access.
GRAFANA_BIND_IP=0.0.0.0

# Grafana Web Dashboard Port (Default: 3000)
GRAFANA_PORT=3000

# PostgreSQL Binding & Port (Optional)
# For maximum security, PostgreSQL is isolated inside the Docker network by default.
# Host port mapping is commented out in docker-compose.yml.
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Database & Admin Credentials
# ------------------------------------------------------------------------------
POSTGRES_DB=dmarc
POSTGRES_USER=parsedmarc
POSTGRES_PASSWORD=parsedmarc_password

# Grafana Admin Credentials & Authentication
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Anonymous Access (Default: true for passwordless viewing)
# Set to 'false' if you want to require username & password login for all viewers.
GRAFANA_ANONYMOUS_ENABLED=true

# ------------------------------------------------------------------------------
# Cloudflare Tunnel Integration (Optional)
# ------------------------------------------------------------------------------

# Public URL when accessed via Cloudflare Tunnel or reverse proxy (e.g. https://dmarc.example.com)
# Needed for proper redirects and domain links in Grafana.
# GRAFANA_ROOT_URL=https://dmarc.example.com

# If your cloudflared container runs in Docker, specify its external Docker network name here.
# When set, Grafana will join this network and cloudflared can route directly to:
#   http://grafana:3000
# without exposing any ports on the host or LAN.
# CLOUDFLARE_TUNNEL_NETWORK=cloudflared_net

# ===================================================
# DMARC Visualizer Configuration
# ===================================================

# Grafana Web Dashboard Port (Default: 3001 to avoid conflicting with existing port 3000)
GRAFANA_PORT=3001

# PostgreSQL Host Port (Default: 5433 to avoid conflicting with existing port 5432)
POSTGRES_PORT=5433

# PostgreSQL Database Credentials
POSTGRES_DB=dmarc
POSTGRES_USER=parsedmarc
POSTGRES_PASSWORD=parsedmarc_password

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
